{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pup-tutor-worksheet-generator",
  "main": "workers/index.ts",
  "compatibility_date": "2025-12-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1a434626c9c143ec874e6c2e1ec2348a",
      "preview_id": "b94eac3c955f44df8eb8722850956947"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    "production": {
      "name": "pup-tutor-worksheet-generator",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "1a434626c9c143ec874e6c2e1ec2348a"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "workers_dev": false
    },
    "development": {
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "dev-namespace",
          "preview_id": "b94eac3c955f44df8eb8722850956947"
        }
      ],
      "vars": {
        "ADMIN_PASSWORD": "admin123"
      }
    }
  }
}
