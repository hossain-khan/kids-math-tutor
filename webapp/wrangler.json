{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pup-tutor-worksheet-generator",
  "main": "workers/index.ts",
  "compatibility_date": "2025-12-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "WORKSHEETS_KV",
      "id": "REPLACE_WITH_ACTUAL_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_ACTUAL_PREVIEW_ID"
    }
  ],
  "env": {
    "development": {
      "routes": [
        {
          "pattern": "localhost:8787/api/*"
        }
      ]
    },
    "production": {
      "routes": [
        {
          "pattern": "mathpup.dev/api/*",
          "zone_name": "mathpup.dev"
        }
      ]
    }
  }
}
