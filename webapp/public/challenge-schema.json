{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://math-worksheet.gohk.xyz/challenge-schema.json",
  "title": "Math Pup Challenge Specification",
  "description": "JSON schema for custom math practice challenges in Kids Math Pup Tutor app",
  "$ref": "#/definitions/ChallengeSpec",
  "definitions": {
    "ChallengeSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "generated"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "subtitle": {
              "type": "string",
              "maxLength": 150
            },
            "operation": {
              "type": "string",
              "enum": [
                "addition",
                "subtraction",
                "multiplication",
                "division"
              ]
            },
            "problemCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "numberRange": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "title",
            "operation",
            "problemCount",
            "numberRange"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "explicit"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "subtitle": {
              "type": "string",
              "maxLength": 150
            },
            "problems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operand1": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "operand2": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "addition",
                      "subtraction",
                      "multiplication",
                      "division"
                    ]
                  }
                },
                "required": [
                  "operand1",
                  "operand2",
                  "operation"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          "required": [
            "type",
            "title",
            "problems"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "examples": [
    {
      "type": "generated",
      "title": "Addition Practice 1-20",
      "subtitle": "Master basic addition skills",
      "operation": "addition",
      "problemCount": 10,
      "numberRange": {
        "min": 1,
        "max": 20
      }
    },
    {
      "type": "explicit",
      "title": "Mixed Math Practice",
      "subtitle": "Custom problems",
      "problems": [
        {
          "operand1": 5,
          "operand2": 3,
          "operation": "addition"
        },
        {
          "operand1": 12,
          "operand2": 4,
          "operation": "division"
        },
        {
          "operand1": 8,
          "operand2": 2,
          "operation": "subtraction"
        },
        {
          "operand1": 6,
          "operand2": 7,
          "operation": "multiplication"
        }
      ]
    }
  ]
}